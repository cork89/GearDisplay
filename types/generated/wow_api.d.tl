global record C_UnitAuras
   -- Registers a sound for an aura event. The sound is stopped after five seconds of playback. The throttleSeconds value must be between 0 and 5 seconds, inclusive. [nilable: auraSoundID]
   AddAuraSound: function(trigger: number, sound: UnitAuraSoundInfo): number
   AddBlockedAura: function(unit: string, auraInstanceID: number)
   -- [nilable: anchorID]
   AddPrivateAuraAnchor: function(args: AddPrivateAuraAnchorArgs): number
   AuraIsBigDefensive: function(spellID: number | string): boolean
   AuraIsPrivate: function(spellID: number | string): boolean
   CancelAuraByInstanceID: function(unit: string, auraInstanceID: number)
   ClearBlockedAuras: function(unit: string)
   -- Returns true if an aura instance will expire after a certain amount of time.
   DoesAuraHaveExpirationTime: function(auraInstanceUnit: string, auraInstanceID: number): boolean
   -- Formats a string for displaying the number of applications an aura has present.
   GetAuraApplicationDisplayCount: function(auraInstanceUnit: string, auraInstanceID: number, minDisplayCount?: number, maxDisplayCount?: number): string
   -- Returns the base duration of the given spell (or aura). Takes an optional spellID to use as the new duration if that cannot be derived from the aura, if that value isn't supplied the aura's spellID will be used [nilable: newDuration]
   GetAuraBaseDuration: function(auraInstanceUnit: string, auraInstanceID: number, spellID?: number | string): number
   -- [nilable: casterGUID]
   GetAuraCasterGUID: function(auraInstanceUnit: string, auraInstanceID: number): string
   -- [nilable: aura]
   GetAuraDataByAuraInstanceID: function(unit: string, auraInstanceID: number): any
   -- [nilable: aura]
   GetAuraDataByIndex: function(unit: string, index: number, filter?: string): any
   -- [nilable: aura]
   GetAuraDataBySlot: function(unit: string, slot: number): any
   -- [nilable: aura]
   GetAuraDataBySpellName: function(unit: string, spellName: string, filter?: string): any
   -- Queries the dispel type associated with an aura instance and remaps it to a color via a curve, with the dispel type ID used as the 'x' value.
   GetAuraDispelTypeColor: function(auraInstanceUnit: string, auraInstanceID: number, curve: any): ColorMixin
   GetAuraDuration: function(auraInstanceUnit: string, auraInstanceID: number): any
   -- [nilable: outContinuationToken]
   GetAuraSlots: function(unit: string, filter?: string, maxSlots?: number, continuationToken?: number): number, number...
   -- [nilable: aura]
   GetBuffDataByIndex: function(unit: string, index: number, filter?: string): any
   -- [nilable: cooldownSpellID]
   GetCooldownAuraBySpellID: function(spellID: number | string): number
   -- [nilable: aura]
   GetDebuffDataByIndex: function(unit: string, index: number, filter?: string): any
   -- Returns the alerts passed to SetGroupBuffVisualAlerts plus an entry for every linked rank spell of those group buffs.
   GetGroupBuffVisualAlerts: function(): {GroupBuffVisualAlertInfo}
   -- Returns the spell IDs passed to SetHiddenGroupBuffs plus every linked rank spell of those group buffs.
   GetHiddenGroupBuffs: function(): {number}
   -- [nilable: aura]
   GetPlayerAuraBySpellID: function(spellID: number | string): any
   -- Returns the client-predicted amount of time that a new spellcast of the same spell would carry over to the new application of that aura. Takes an optional spellID to use as the new duration if that cannot be derived from the aura, if that value isn't supplied the aura's spellID will be used [nilable: newDuration]
   GetRefreshCarryOverDuration: function(auraInstanceUnit: string, auraInstanceID: number, spellID?: number | string): number
   -- Returns the client-predicted new duration of this aura if it were cast again right now. Takes an optional spellID to use as the new duration if that cannot be derived from the aura, if that value isn't supplied the aura's spellID will be used [nilable: newDuration]
   GetRefreshExtendedDuration: function(auraInstanceUnit: string, auraInstanceID: number, spellID?: number | string): number
   -- Returns the first instance of an aura on a unit matching a given spell ID. Returns nil if no such aura is found. Additionally can return nil if querying a unit that is not visible (eg. party members on other maps). [nilable: aura]
   GetUnitAuraBySpellID: function(unit: string, spellID: number | string): any
   GetUnitAuraInstanceIDs: function(unit: string, filter: string, maxCount?: number, sortRule?: number, sortDirection?: number): {number}
   GetUnitAuras: function(unit: string, filter: string, maxCount?: number, sortRule?: number, sortDirection?: number): {any}
   IsAuraFilteredOutByInstanceID: function(unit: string, auraInstanceID: number, filter: string): boolean
   RemoveAuraSound: function(auraSoundID: number)
   RemovePrivateAuraAnchor: function(anchorID: number)
   ResetAuraDataProvider: function()
   SetGroupBuffVisualAlerts: function(visualAlerts: {GroupBuffVisualAlertInfo})
   SetHiddenGroupBuffs: function(spellIDs: {number})
   SetPrivateWarningTextAnchor: function(parent: Frame, anchor?: AnchorBinding)
   SwitchAuraDataProvider: function()
   WantsAlteredForm: function(unit: string): boolean
end
