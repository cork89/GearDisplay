global record AuraContainerTooltipBackdropInfo
   -- Optional background texture asset. [nilable]
   bgFile: integer | string
   -- Optional edge texture asset. [nilable]
   edgeFile: integer | string
   -- Optional edge size. [nilable]
   edgeSize: number
   -- Optional backdrop insets. [nilable]
   insets: AuraContainerTooltipBackdropInsets
   -- If true, tiles the background texture. [nilable]
   tile: boolean
   -- If true, tiles the edge texture. [nilable]
   tileEdge: boolean
   -- Optional tile size used when tiling the background texture. [nilable]
   tileSize: number
end
global record AuraContainerTooltipBackdropInsets
   left: number
   right: number
   top: number
   bottom: number
end
global record AuraContainerTooltipBackdropOptions
   -- Backdrop information used to construct the tooltip backdrop.
   backdropInfo: AuraContainerTooltipBackdropInfo
   -- Optional color applied to the backdrop border. [nilable]
   borderColor: ColorMixin
   -- Optional color applied to the backdrop background. [nilable]
   centerColor: ColorMixin
   -- Optional offsets applied to the backdrop's TOPLEFT and BOTTOMRIGHT anchor points. [nilable]
   anchorOffsets: AuraContainerTooltipAnchorOffsets
end
global record AuraContainerTooltipNineSliceOptions
   -- Name of the NineSlice layout template to apply, such as 'TooltipDefaultLayout'.
   layoutName: string
   -- Optional color applied to the NineSlice border. [nilable]
   borderColor: ColorMixin
   -- Optional color applied to the NineSlice center region. [nilable]
   centerColor: ColorMixin
   -- Optional offsets applied to the NineSlice's TOPLEFT and BOTTOMRIGHT anchor points. [nilable]
   anchorOffsets: AuraContainerTooltipAnchorOffsets
end
global record AuraContainerTooltipTextureSliceOptions
   -- Texture asset (file path or atlas name) displayed by the slice.
   asset: integer | string
   -- Optional texture slice margins. See Texture:SetTextureSliceMargins. [nilable]
   sliceMargins: UITextureSliceMargins
   -- Optional texture slice mode. See Texture:SetTextureSliceMode. [nilable]
   sliceMode: number
   -- Optional vertex color applied to the texture. [nilable]
   color: ColorMixin
   -- Optional offsets applied to the slice's TOPLEFT and BOTTOMRIGHT anchor points. [nilable]
   anchorOffsets: AuraContainerTooltipAnchorOffsets
   -- Draw layer used when displaying the texture. [nilable]
   drawLayer: DrawLayer
   -- Draw layer sublevel used when displaying the texture.
   drawLayerSublevel: number
end
