   SetAtlas: function(self, atlas: string, useAtlasSize?: boolean, filterMode?: FilterMode, resetTexCoords?: boolean, wrapModeHorizontal?: string, wrapModeVertical?: string)
   SetBlendMode: function(self, blendMode: BlendMode)
   SetBlockingLoadsRequested: function(self, blocking?: boolean)
