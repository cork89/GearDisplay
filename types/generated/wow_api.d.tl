global record SpellBookItemInfo
   -- Represents a base spellID for spells, flyoutID for flyouts, or petActionID for pet actions
   actionID: number
   -- May be nil if item is not a spell; Will be the overriding spellID if spell is overriden, otherwise will match actionID [nilable]
   spellID: number
   itemType: number
   name: string
   -- May be empty if flyout, or if spell's data isn't loaded yet; Listen for SPELL_TEXT_UPDATE event, or use SpellMixin to load asynchronously
   subName: string
   iconID: integer
   -- True if the item is a passive spell; Will always be false if it is not a spell
   isPassive: boolean
   -- True if the item belongs to a non-active specialization
   isOffSpec: boolean
   -- Index of the SkillLine this SpellBookItem is part of; Nil this SpellBookItem isn't part of a SkillLine [nilable]
   skillLineIndex: number
end
global record SpellBookSkillLineInfo
   name: string
   iconID: integer
   -- This value + 1 is the first Spell Book Item slotIndex within this skill line
   itemIndexOffset: number
   numSpellBookItems: number
   isGuild: boolean
   shouldHide: boolean
   -- Will be nil if this skill line is not associated with a specialization [nilable]
   specID: number
   -- Will be nil if this skill line is not associated with a non-active specialization [nilable]
   offSpecID: number
end
global record SpellChargeInfo
   -- Number of charges currently available
   currentCharges: number
   -- Max number of charges that can be accumulated
   maxCharges: number
   -- If charge cooldown is active, time at which the most recent charge cooldown began; 0 if cooldown is not active
   cooldownStartTime: number
   -- Cooldown duration in seconds required to generate a charge
   cooldownDuration: number
   -- Rate at which cooldown UI should update
   chargeModRate: number
   -- False if recharging is not active (ex: at maximum available charges, start time or duration are zero); True otherwise
   isActive: boolean
end
global record SpellCooldownInfo
   -- If cooldown is active, time started; 0 if no cooldown; Current time if isEnabled is false
   startTime: number
   -- Cooldown duration in seconds if active; 0 if cooldown is inactive
   duration: number
   -- False if cooldown is on hold (ex: some cooldowns only start after an active spell is cancelled); True otherwise
   isEnabled: boolean
   -- False if cooldown is not active (ex: not enabled, or startTime or duration are 0); True otherwise
   isActive: boolean
   -- Rate at which cooldown UI should update
   modRate: number
   -- Indicates which category is responsible for determining the duration. A nil value indicates the duration was determined through some other logic, e.g. the spell is on hold. [nilable]
   activeCategory: number
   -- When this is set it indicates that the spell is in recovery and this is how long it will be until that recovery period is finished [nilable]
   timeUntilEndOfStartRecovery: number
   -- Whether or not this spell is considered to be on the global cooldown, do not trust this field unless responding to a SPELL_UPDATE_COOLDOWN event [nilable]
   isOnGCD: boolean
end
global record SpellDiminishCategoryInfo
   category: number
   name: string
   -- [nilable]
   icon: integer
end
global record SpellDiminishTrackerInfo
   category: number
   startTime: number
   duration: number
   showCountdown: boolean
   isImmune: boolean
end
