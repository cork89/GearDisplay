   HasPlayerEarnedATalentPoint: function(): boolean
   IsInitialized: function(): boolean
   IsPvpTalentLocked: function(talentID: number): boolean
   IsSpecSelectionEnabled: function(classID: number): boolean
   MatchesCurrentSpecSet: function(specSetID: number): boolean
   SetActiveSpecGroup: function(groupIndex: number)
   SetPetSpecialization: function(specIndex: number, petNumber?: number)
   SetPvpTalentLocked: function(talentID: number, locked: boolean)
   SetSpecialization: function(specIndex: number): boolean
end
-- SpellDocumentation.lua
global record C_Spell
   -- Cancels the player's active auto repeat spell, if any
   CancelAutoRepeatSpell: function(): boolean
   -- Cancel a temporary enchantment on an item
   CancelItemTempEnchantment: function(weaponSlot: number, enchantmentType: number)
   CancelSpellByID: function(spellID: number)
   -- Returns true if the spell exists, regardless of whether the player has learned it
   DoesSpellExist: function(spellIdentifier: number | string): boolean
   -- Used in conjunction with SpellRangeCheckUpdate to inform the UI when a spell goes in or out of range with the current target.
   EnableSpellRangeCheck: function(spellIdentifier: number | string, enable: boolean)
   GetAuraStatChanges: function(spellID: number): number, {PowerTypeChange}
   GetBaseSpell: function(spellIdentifier: number | string, spec?: number): number
   -- [may return nothing]
   GetDeadlyDebuffInfo: function(spellIdentifier: number | string): DeadlyDebuffInfo
   -- Returns nil if the item is not found or on cooldown [may return nothing]
   GetItemCooldown: function(itemID: number): SpellCooldownInfo
   GetItemModifiedAppearancesApplied: function(spellID: number): {number}
   -- Searches for the most recent spellID and itemID that started a cooldown in this category [may return nothing] [nilable: spellID] [nilable: itemID]
   GetLastCategoryCooldownSource: function(spellCategory: number): number, number
   -- [may return nothing]
   GetMawPowerLinkBySpellID: function(spellID: number | string): string
   -- [may return nothing]
   GetMawPowerRarityInfoBySpellID: function(spellID: number | string): number, string
   GetOverrideSpell: function(spellIdentifier: number | string, spec?: number, onlyKnown?: boolean, ignoreOverrideSpellID?: number): number
   GetSchoolString: function(schoolMask: number): string
   -- Returns nil if spell is not found [may return nothing]
   GetSpellAutoCast: function(spellIdentifier: number | string): boolean, boolean
   -- Returns number of times a spell can be cast, typically based on availability of things like required reagent items; Returns 0 if spell is not found
   GetSpellCastCount: function(spellIdentifier: number | string): number
   -- Returns a duration object describing the active recharge time for a spell. [may return nothing]
   GetSpellChargeDuration: function(spellIdentifier: number | string): any
   -- Returns a table of info about the charges of a charge-accumulating spell; May return nil if spell is not found or is not charge-based [may return nothing]
   GetSpellCharges: function(spellIdentifier: number | string): SpellChargeInfo
   -- Returns nil if spell is not found [may return nothing]
   GetSpellCooldown: function(spellIdentifier: number | string): SpellCooldownInfo
   -- Returns a duration object describing the active cooldown duration for a spell. [may return nothing]
   GetSpellCooldownDuration: function(spellIdentifier: number | string, ignoreGCD?: boolean): any
   -- Returns nil if spell is not found [may return nothing]
   GetSpellDescription: function(spellIdentifier: number | string): string
   -- Returns nil if spell is not found [may return nothing]
   GetSpellDescriptionForItemLocation: function(spellIdentifier: number | string, itemLocation: ItemLocation): string
   -- Depending on the spell, return a string that is either the use count or number of charges. If value is beyond the display count parameter, returns the replacementString (defaults to '*').
   GetSpellDisplayCount: function(spellIdentifier: number | string, maxDisplayCount?: number, replacementString?: string): string
   -- Meant primarily for getting a spell id from a spell name or link; Returns nothing if spell does not exist [may return nothing]
   GetSpellIDForSpellIdentifier: function(spellIdentifier: number | string): number
   -- Returns nil if spell is not found [may return nothing]
   GetSpellInfo: function(spellIdentifier: number | string): SpellInfo
   -- Returns the level the spell is learned at; May return a different value if the player is currently Level Linked with another player
   GetSpellLevelLearned: function(spellIdentifier: number | string): number
   -- Returns nil if spell is not found [may return nothing]
   GetSpellLink: function(spellIdentifier: number | string, glyphID?: number): string
   -- Returns a duration object describing the active loss of control cooldown duration for a spell. [may return nothing]
   GetSpellLossOfControlCooldownDuration: function(spellIdentifier: number | string): any
   -- Returns nil if spell is not found [may return nothing]
   GetSpellLossOfControlCooldownInfo: function(spellIdentifier: number | string): SpellLossOfControlInfo
   GetSpellMaxCumulativeAuraApplications: function(spellID: number | string): number
   -- Returns nil if spell is not found [may return nothing]
   GetSpellName: function(spellIdentifier: number | string): string
   -- Returns a table containing one or more SpellPowerCostInfos, one for each power type this spell costs; May return nil if spell is not found or has no resource costs [may return nothing]
   GetSpellPowerCost: function(spellIdentifier: number | string): {SpellPowerCostInfo}
   GetSpellQueueWindow: function(): number
   -- Returns the rank of a spell that corresponds to an ability within a ranked SkillLine (ex: a crafting Recipe); Returns nil if spell is not found, or isn't part of a ranked SkillLine [may return nothing]
   GetSpellSkillLineAbilityRank: function(spellIdentifier: number | string): number
   -- Returns nil if spell is not found [may return nothing]
   GetSpellSubtext: function(spellIdentifier: number | string): string
   -- Returns nothing if spell is not found [may return nothing] [nilable: conditionalIconID]
   GetSpellTexture: function(spellIdentifier: number | string): integer, integer, integer
   -- Returns nil if spell is not associated with a trade skill [may return nothing]
   GetSpellTradeSkillLink: function(spellIdentifier: number | string): string
   GetTargetSpellID: function(): number
   -- [may return nothing]
   GetVisibilityInfo: function(spellID: number, visibilityType: number): boolean, boolean, boolean
   -- Returns true if the spell is a currently active toggled spell
   IsActiveSpell: function(spellIdentifier: number | string, targetUnit?: string): boolean
   -- Returns true if the spell is the player's melee Auto Attack spell
   IsAutoAttackSpell: function(spellIdentifier: number | string): boolean
   -- Returns true if the spell is an auto repeat player spell
   IsAutoRepeatSpell: function(spellIdentifier: number | string): boolean
   -- Returns true if the spell comes from a Class Talent
   IsClassTalentSpell: function(spellIdentifier: number | string): boolean
   IsConsumableSpell: function(spellIdentifier: number | string): boolean
   -- Returns true if the spell is currently being cast or is queued to be cast
   IsCurrentSpell: function(spellIdentifier: number | string): boolean
   -- Returns true if an aura is considered an external defensive.
   IsExternalDefensive: function(spellID: number): boolean
   -- Returns true if the spell is an 'empower' type spell that is cast by pressing and holding, with the on-release cast typically being affected by time held
   IsPressHoldReleaseSpell: function(spellIdentifier: number | string): boolean
   -- Returns true if an aura is considered high priority and should be ordered ahead of other auras in the UI.
   IsPriorityAura: function(spellID: number): boolean
   -- Returns true if the spell comes from a PvP Talent
   IsPvPTalentSpell: function(spellIdentifier: number | string): boolean
   -- Returns true if the spell is the player's ranged Auto Attack spell (ex: Shoot, Auto Shot, etc)
   IsRangedAutoAttackSpell: function(spellIdentifier: number | string): boolean
   -- Returns true if an aura only applies effects to the player, and no other units.
   IsSelfBuff: function(spellID: number): boolean
   -- Returns true if the spell causes a crowd control effect when cast on a valid target.
   IsSpellCrowdControl: function(spellIdentifier: number | string): boolean
   -- Returns true if data for the spell has already been loaded and cached this session
   IsSpellDataCached: function(spellIdentifier: number | string): boolean
   IsSpellDisabled: function(spellIdentifier: number | string): boolean
   -- Returns true if the spell can be cast on hostile targets
   IsSpellHarmful: function(spellIdentifier: number | string): boolean
   -- Returns true if the spell can be cast on the player or other friendly targets
   IsSpellHelpful: function(spellIdentifier: number | string): boolean
   -- Returns true if the spell is considered important. For example a spell that's lethal if not interrupted would be considered important.
   IsSpellImportant: function(spellIdentifier: number | string): boolean
   -- Returns true if the current target is within range of the spell; False if out of range; Nil if range check was invalid [nilable: inRange]
   IsSpellInRange: function(spellIdentifier: number | string, targetUnit?: string): boolean
   IsSpellPassive: function(spellIdentifier: number | string): boolean
   -- Returns whether the spell is currently castable; Typically based on things like learned status, required resources, etc
   IsSpellUsable: function(spellIdentifier: number | string): boolean, boolean
   PickupSpell: function(spellIdentifier: number | string)
   PlaceTargetingSpellAtCursor: function()
   -- Requests data for the spell be loaded; Listen for SPELL_DATA_LOAD_RESULT to be notified when load is finished
   RequestLoadSpellData: function(spellIdentifier: number | string)
   SetSpellAutoCastEnabled: function(spellIdentifier: number | string, enabled: boolean)
   -- Returns true if the spell has a min and/or max range greater than 0
   SpellHasRange: function(spellIdentifier: number | string): boolean
   TargetSpellChecksItemCondition: function(): boolean
   TargetSpellIsEnchanting: function(): boolean
   TargetSpellJumpsUpgradeTrack: function(): boolean
   TargetSpellReplacesBonusTree: function(): boolean
   -- Toggles whether spell's autoCast is enabled
   ToggleSpellAutoCast: function(spellIdentifier: number | string)
end
