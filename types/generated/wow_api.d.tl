-- SpellBookDocumentation.lua
global record C_SpellBook
   AbortSpellIntro: function(spellID: number)
   CastSpellBookItem: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number, targetSelf?: boolean)
   -- Returns true if player knows any Disenchant spells
   ContainsAnyDisenchantSpell: function(): boolean
   -- [nilable: baseSpellID]
   FindBaseSpellByID: function(spellID: number): number
   FindFlyoutSlotBySpellID: function(spellID: number): number
   -- If found, returns the first slot position of a SpellBookItem matching the specified spell and criteria [may return nothing]
   FindSpellBookSlotForSpell: function(spellIdentifier: number | string, includeHidden?: boolean, includeFlyouts?: boolean, includeFutureSpells?: boolean, includeOffSpec?: boolean): number, number
   -- [nilable: overrideSpellID]
   FindSpellOverrideByID: function(spellID: number): number
   -- [may return nothing]
   GetClassSkillLineInfo: function(): SpellBookSkillLineInfo
   -- Returns general, class, and active spec spells that are learned at the specified level [may return nothing]
   GetCurrentLevelSpells: function(level: number): {number}
   GetNumSpellBookSkillLines: function(): number
   -- [nilable: skillIndex]
   GetSkillLineIndexByID: function(skillLineID: number): number
   -- Returns nothing if item doesn't exist or isn't a spell [may return nothing]
   GetSpellBookItemAutoCast: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean, boolean
   -- Returns number of times a SpellBookItem can be cast, typically based on availability of things like required reagent items; Always returns 0 if item is not found or is not a spell
   GetSpellBookItemCastCount: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): number
   -- Returns a duration object describing the active recharge time for a spellbook item. [may return nothing]
   GetSpellBookItemChargeDuration: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): any
   -- Returns a table of info about the charges of a charge-accumulating SpellBookItem; May return nil if item is not found or is not charge-based [may return nothing]
   GetSpellBookItemCharges: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): SpellChargeInfo
   -- Returns nil if item doesn't exist or if this kind of item doesn't display cooldowns (ex: future or offspec spells) [may return nothing]
   GetSpellBookItemCooldown: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): SpellCooldownInfo
   -- Returns a duration object describing the active cooldown duration for a spellbook item. [may return nothing]
   GetSpellBookItemCooldownDuration: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number, ignoreGCD?: boolean): any
   -- [may return nothing]
   GetSpellBookItemDescription: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): string
   -- [may return nothing]
   GetSpellBookItemInfo: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): SpellBookItemInfo
   -- Returns the level the spell is learned at; May return a different value if the player is currently Level Linked with another player; Returns 0 if item is not a Spell
   GetSpellBookItemLevelLearned: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): number
   -- [may return nothing]
   GetSpellBookItemLink: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number, glyphID?: number): string
   -- Returns a duration object describing the active loss of control cooldown duration for a spellbook item. [may return nothing]
   GetSpellBookItemLossOfControlCooldownDuration: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): any
   -- Returns nil if item doesn't exist or if this kind of item doesn't display cooldowns (ex: future or offspec spells) [may return nothing]
   GetSpellBookItemLossOfControlCooldownInfo: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): SpellLossOfControlInfo
   -- [may return nothing]
   GetSpellBookItemName: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): string, string
   -- Returns a table containing one or more SpellPowerCostInfos, one for each power type a SpellBookItem costs; May return nil if item is not found or has no resource costs [may return nothing]
   GetSpellBookItemPowerCost: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): {SpellPowerCostInfo}
   -- Get the index of the SkillLine this SpellBookItem is part of [nilable: skillLineIndex]
   GetSpellBookItemSkillLineIndex: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): number
   -- [may return nothing]
   GetSpellBookItemTexture: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): integer
   -- Returns nil if SpellBookItem is not associated with a trade skill [may return nothing]
   GetSpellBookItemTradeSkillLink: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): string
   -- [may return nothing] [nilable: spellID]
   GetSpellBookItemType: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): number, number, number
   -- [may return nothing]
   GetSpellBookSkillLineInfo: function(skillLineIndex: number): SpellBookSkillLineInfo
   -- Returns nothing if player has no pet spells [may return nothing]
   HasPetSpells: function(): number, string
   -- Returns true if the SpellBookItem is the player's melee Auto Attack spell
   IsAutoAttackSpellBookItem: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookItem comes from a Class Talent
   IsClassTalentSpellBookItem: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookItem comes from a PvP Talent
   IsPvPTalentSpellBookItem: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookItem is the player's ranged Auto Attack spell (ex: Shoot, Auto Shot, etc)
   IsRangedAutoAttackSpellBookItem: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookIem can be cast on hostile targets
   IsSpellBookItemHarmful: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookIem can be cast on the player or other friendly targets
   IsSpellBookItemHelpful: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the current target is within range of the SpellBookIem; False if out of range; Nil if range check was invalid [nilable: inRange]
   IsSpellBookItemInRange: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number, targetUnit?: string): boolean
   -- Returns true if the SpellBookItem is represented in a Flyout.
   IsSpellBookItemLooseFlyoutMember: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookItem is a lower rank of a known higher rank spell.  Returns false if there is only a single rank or it is the highest rank known.
   IsSpellBookItemLowRank: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookItem belongs to a non-active class specialization
   IsSpellBookItemOffSpec: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns true if the SpellBookItem is a passive spell; Will always return false if it is not a spell
   IsSpellBookItemPassive: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   -- Returns whether the SpellBookIem is currently castable; Typically based on things like learned status, required resources, etc
   IsSpellBookItemUsable: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean, boolean
   -- Returns true if a spell should be found in the spellbook. This function can also return true for spells that aren't known, such as override spells granted by an aura linked to class talents
   IsSpellInSpellBook: function(spellID: number, spellBank?: number, includeOverrides?: boolean): boolean
   -- Returns true if a player knows a spell. This function can also return true for spells that aren't in the spellbook, such as temporarily-granted abilities
   IsSpellKnown: function(spellID: number, spellBank?: number): boolean
   -- Returns true if a spell is considered to be known or present in the spellbook
   IsSpellKnownOrInSpellBook: function(spellID: number, spellBank?: number, includeOverrides?: boolean): boolean
   PickupSpellBookItem: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number)
   SetBarSlotFromIntro: function(spellID: number, slotIndex: number)
   SetSpellBookItemAutoCastEnabled: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number, enabled: boolean)
   -- Returns true if the SpellBookIem has a min and/or max range greater than 0; Will always return false if it is not a spell
   SpellBookItemHasRange: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number): boolean
   ToggleSpellBookItemAutoCast: function(spellBookItemSlotIndex: number, spellBookItemSpellBank: number)
end
