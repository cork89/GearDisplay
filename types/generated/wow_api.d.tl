-- AddOnProfilerDocumentation.lua
global record C_AddOnProfiler
   -- Adds a measured event to any ongoing measured calls. If no such calls are currently taking place, this function does nothing.
   AddMeasuredCallEvent: function(name: string)
   -- Internal API for telemetry.
   AddPerformanceMessageShown: function(msg: AddOnPerformanceMessage)
   -- Optimized check for determining if AddOns are severely impacting UI performance. [may return nothing]
   CheckForPerformanceMessage: function(): AddOnPerformanceMessage
   -- Gets an AddOn profiler value - all times returned are in milliseconds.
   GetAddOnMetric: function(name: string, metric: number): number
   -- Overall profiling data for the entire application (not just the UI)
   GetApplicationMetric: function(metric: number): number
   -- Overall profiling data for all addons
   GetOverallMetric: function(metric: number): number
   -- Returns the number of profiling clock ticks that occur within a single real-time second.
   GetTicksPerSecond: function(): number
   -- Gets top K AddOns for a given metric.
   GetTopKAddOnsForMetric: function(metric: number, k: number): {AddOnProfilerResult}
   -- AddOn profiler will be enabled for all users, but this will return false if it ever isn't
   IsEnabled: function(): boolean
   -- Performs a profiled measurement of a single function call with any supplied arguments.
   MeasureCall: function(func: any, ...: any): AddOnProfilerCallResults, any...
end
-- AddOnsDocumentation.lua
global record C_AddOns
   DisableAddOn: function(name: string | number, character?: string)
   DisableAllAddOns: function(character?: string)
