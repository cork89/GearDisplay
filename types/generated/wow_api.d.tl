-- PartyInfoDocumentation.lua, PartyInfoSystemStatusDocumentation.lua
global record C_PartyInfo
   AllowedToDoPartyConversion: function(toRaid: boolean): boolean
   CanFormCrossFactionParties: function(): boolean
   CanInvite: function(): boolean
   -- Returns whether it's possible to start a vote at this time
   CanStartInstanceAbandonVote: function(): boolean
   ChallengeModeRestrictionsActive: function(): boolean
   -- Immediately convert to raid with no regard for potentially destructive actions.
   ConfirmConvertToRaid: function()
   ConfirmInviteTravelPass: function(targetName: string, targetGUID: string)
   -- Immediately invites the named unit to a party, with no regard for potentially destructive actions.
   ConfirmInviteUnit: function(targetName: string)
   -- Immediately leave the party with no regard for potentially destructive actions
   ConfirmLeaveParty: function(category?: number)
   ConfirmReadyCheck: function(isReady: boolean)
   -- Immediately request an invite into the target party, this is the confirmation function to call after RequestInviteFromUnit, or if you would like to skip the confirmation process.
   ConfirmRequestInviteFromUnit: function(targetName: string, tank?: boolean, healer?: boolean, dps?: boolean)
   ConvertToParty: function()
   -- Usually this will convert to raid immediately. In some cases (e.g. PartySync) the user will be prompted to confirm converting to raid, because it's potentially destructive.
   ConvertToRaid: function()
   DelveTeleportOut: function()
   DemoteAssistant: function(name: string, exactNameMatch?: boolean)
   DoCountdown: function(seconds: number): boolean
   DoReadyCheck: function()
   -- [may return nothing]
   GetActiveCategories: function(): {number}
   GetAvailableLootMethods: function(): {number}
   -- Returns the total duration of the shutdown time after a vote passes and how much time is left before it ends
   GetInstanceAbandonShutdownTime: function(): number, number
   -- Returns the total duration of the abandon vote cooldown and how much time is left before it ends [may return nothing]
   GetInstanceAbandonVoteCooldownTime: function(): number, number
   -- Returns values controlling the vote
   GetInstanceAbandonVoteRequirements: function(): number, number
   -- Returns how the player voted, nil for not yet [nilable: response]
   GetInstanceAbandonVoteResponse: function(): boolean
   -- Returns the total duration of the vote and how much time is left before it ends
   GetInstanceAbandonVoteTime: function(): number, number
   -- [may return nothing]
   GetInviteConfirmationInvalidQueues: function(inviteGUID: string): {QueueSpecificInfo}
   -- [may return nothing]
   GetInviteReferralInfo: function(inviteGUID: string): string, string, number, boolean, string
   -- [nilable: masterLootPartyID] [nilable: masterLooterRaidID]
   GetLootMethod: function(): number, number, number
   GetLootMethodStyle: function(): number
   GetMinItemLevel: function(avgItemLevelCategory: number): number, string
   GetMinLevel: function(category?: number): number
   -- Returns how many players have voted either way
   GetNumInstanceAbandonGroupVoteResponses: function(): number
   GetRestrictPings: function(): number
   -- Attempt to invite the named unit to a party, requires confirmation in some cases (e.g. the party will convert to a raid, or if there is a party sync in progress).
   InviteUnit: function(targetName: string)
   IsChallengeModeActive: function(): boolean
   IsChallengeModeKeystoneOwner: function(): boolean
   IsCrossFactionParty: function(category?: number): boolean
   IsDelveComplete: function(): boolean
   IsDelveInProgress: function(): boolean
   IsGUIDInGroup: function(guid: string, category?: number): boolean
   IsLootMethodAvailable: function(method: number): boolean
   IsPartyFull: function(category?: number): boolean
   IsPartyInJailersTower: function(): boolean
   IsPartyWalkIn: function(): boolean
   -- Usually this will leave the party immediately. In some cases (e.g. PartySync) the user will be prompted to confirm leaving the party, because it's potentially destructive
   LeaveParty: function(category?: number)
   PromoteToAssistant: function(name: string, exactNameMatch?: boolean)
   PromoteToLeader: function(name: string, exactNameMatch?: boolean)
   -- Attempt to request an invite into the target party, requires confirmation in some cases (e.g. there is a party sync in progress).
   RequestInviteFromUnit: function(targetName: string, tank?: boolean, healer?: boolean, dps?: boolean)
   SetEveryoneIsAssistant: function(isAssistant: boolean): boolean
   -- Vote on whether to abandon instance, true for yes, false for no
   SetInstanceAbandonVoteResponse: function(response: boolean)
   SetLootMethod: function(method: number, lootMaster?: string): boolean
   SetRestrictPings: function(restrictTo: number)
