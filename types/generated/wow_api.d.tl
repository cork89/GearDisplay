   GetHorizTile: function(self): boolean
   -- Returns the end angle offset of the radial progress bar as a normalized value (0 to 1).
   GetRadialProgressBarEndOffset: function(self): number
   -- Returns the feather/blur amount applied to the radial progress bar edge.
   GetRadialProgressBarFeather: function(self): number
   -- Returns the fill percentage of the radial progress bar (0 to 1).
   GetRadialProgressBarPercent: function(self): number
   -- Returns whether the radial progress bar fills in reverse (counterclockwise) direction.
   GetRadialProgressBarReverse: function(self): boolean
   -- Returns the start angle offset of the radial progress bar as a normalized value (0 to 1).
   GetRadialProgressBarStartOffset: function(self): number
   GetRotation: function(self): number, Vector2DMixin
   GetTexCoord: function(self): number, number, number, number, number, number, number, number
