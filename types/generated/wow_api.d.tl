   -- Get the ranges of the messages currently downloaded.
   GetMessageRanges: function(clubId: string, streamId: string): {ClubMessageRange}
   -- Get downloaded messages before (and including) the specified messageId limited by count. These are filtered by ignored players
   GetMessagesBefore: function(clubId: string, streamId: string, newest: ClubMessageIdentifier, count: number): {ClubMessageInfo}
   -- Get downloaded messages in the given range. These are filtered by ignored players
   GetMessagesInRange: function(clubId: string, streamId: string, oldest: ClubMessageIdentifier, newest: ClubMessageIdentifier): {ClubMessageInfo}
   -- [nilable: streamInfo]
   GetStreamInfo: function(clubId: string, streamId: string): ClubStreamInfo
   -- [nilable: lastReadTime]
   GetStreamViewMarker: function(clubId: string, streamId: string): number
   GetStreams: function(clubId: string): {ClubStreamInfo}
   GetSubscribedClubs: function(): {ClubInfo}
   -- Get the existing tickets for this club. Call RequestTickets() to retrieve tickets from server.
   GetTickets: function(clubId: string): {ClubTicketInfo}
   IsAccountMuted: function(clubId: string): boolean
   -- Returns whether the given message is the first message in the stream, taking into account ignored messages
   IsBeginningOfStream: function(clubId: string, streamId: string, messageId: ClubMessageIdentifier): boolean
   IsEnabled: function(): boolean
   IsRestricted: function(): number
   IsSubscribedToStream: function(clubId: string, streamId: string): boolean
   -- Check kickableRoleIds privilege.
   KickMember: function(clubId: string, memberId: any)
   LeaveClub: function(clubId: string)
   RedeemTicket: function(ticketId: string)
   -- Request invitations for this club from server. Check canGetInvitation privilege.
   RequestInvitationsForClub: function(clubId: string)
   -- Call this when the user scrolls near the top of the message view, and more need to be displayed. The history will be downloaded backwards (newest to oldest).
   RequestMoreMessagesBefore: function(clubId: string, streamId: string, messageId?: ClubMessageIdentifier, count?: number): boolean
   RequestTicket: function(ticketId: string)
   -- Request tickets from server. Check canGetTicket privilege.
   RequestTickets: function(clubId: string)
   -- Check canRevokeOwnInvitation or canRevokeOtherInvitation
   RevokeInvitation: function(clubId: string, memberId: any)
   SendBattleTagFriendRequest: function(guildClubId: string, memberId: any)
   SendCharacterInvitation: function(clubId: string, character: string)
   -- Check the canSendInvitation privilege.
   SendInvitation: function(clubId: string, memberId: any)
   SendMessage: function(clubId: string, streamId: string, message: string)
   SendTitleFriendRequest: function(guildClubId: string, memberId: any)
   -- Only one stream can be set for auto-advance at a time. Focused streams will have their view times advanced automatically.
   SetAutoAdvanceStreamViewMarker: function(clubId: string, streamId: string)
   SetAvatarTexture: function(texture: Texture, avatarId: number, clubType: number)
   -- Check the canSetOwnMemberNote and canSetOtherMemberNote privileges.
   SetClubMemberNote: function(clubId: string, memberId: any, note: string)
   -- You can only be subscribed to 0 or 1 clubs for presence.  Subscribing to a new club automatically unsuscribes you to existing subscription.
   SetClubPresenceSubscription: function(clubId: string)
   SetClubStreamNotificationSettings: function(clubId: string, settings: {ClubStreamNotificationSetting})
   SetCommunityID: function(communityID: number)
   SetFavorite: function(clubId: string, isFavorite: boolean)
   SetSocialQueueingEnabled: function(clubId: string, enabled: boolean)
   ShouldAllowClubType: function(clubType: number): boolean
   UnfocusAllStreams: function(unsubscribe: boolean)
   UnfocusMembers: function(clubId: string)
   UnfocusStream: function(clubId: string, streamId: string)
   ValidateText: function(clubType: number, text: string, clubFieldType: number): number
end
