global record EncounterTimelineEventFilter
   -- Maximum number of sorted events to return. [nilable]
   maxEventCount: number
   -- Maximum duration of sorted events to return. [nilable]
   maxEventDuration: any
   -- If false, include events that are terminal states such as Canceled or Finished.
   excludeTerminalStates: boolean
   -- If false, include events that should be hidden by user configuration, such as events on long tracks when the user has opted to not show long countdowns.
   excludeHiddenEvents: boolean
end
global record EncounterTimelineEventInfo
   -- Instance ID for this event.
   id: number
   -- Source that this event came from.
   source: number
   -- Spell name associated with this event. For script events, this may instead be the contents of the 'overrideName' field if it wasn't empty.
   spellName: string
   -- Spell ID associated with this event.
   spellID: number
   -- Icon file ID associated with this event.
   iconFileID: integer
   -- Base duration of this event at the point that it was queued onto the timeline.
   duration: any
   -- Hold duration for this event after it reaches the end of the timeline. During this period, the event will sit in the queued track of the timeline until manually finished or this added duration expires.
   maxQueueDuration: any
   -- Bitmask of active icon states for this event.
   icons: number
   -- Severity of this event.
   severity: number
   -- If true, this event is an approximation and may not occur exactly when the timeline suggests it will.
   isApproximate: boolean
end
global record EncounterTimelineScriptEventRequest
   spellID: number
   iconFileID: integer
   duration: any
   maxQueueDuration: any
   overrideName: string
   -- [nilable]
   icons: number
   severity: number
   paused: boolean
end
global record EncounterTimelineTrackInfo
   id: number
   ["type"]: number
   -- The exclusive lower bound of durations for events on this track. If zero, this should be treated as an inclusive lower bound. This bound is ignored by the timeline sequence in circumstances where an adjacent Sorted track would exceed its maximum event count, requiring events be pushed 'to the left' by one track. [nilable]
   minimumDuration: any
   -- The inclusive upper bound of durations for events on this track. [nilable]
   maximumDuration: any
   -- Lower duration bound for events that want to transition onto this track from an Indeterminate position. Events below this duration are artificially kept in the indeterminate track state until they can transition into a later track in the timeline sequence. [nilable]
   minimumEventIntroDuration: any
   -- Minimum duration gap that must exist between two sequential candidate events for this track. If two event durations have a distance under this figure, the later of the two events will be artifically kept in the indeterminate track state until it can transition into a later track in the timeline sequence. [nilable]
   minimumEventGapDuration: any
   -- The maximum number of events permitted within this track. This only applies to Sorted tracks. [nilable]
   maximumEventCount: number
   -- Sort ordering for events within this track. This only applies to Sorted tracks. [nilable]
   sortDirection: number
end
