-- IntlDocumentation.lua
global record C_Intl
   -- Compares two UTF-8 strings using the options specified on a collator. [may return nothing]
   CompareStrings: function(left: string, right: string, strength: number): number
   -- Creates a locale context object for locale-scoped internationalization operations.
   CreateLocaleContext: function(locale: string): any
   -- Opens a break iterator for locating text boundaries in a specified locale. [may return nothing]
   FindBreaks: function(text: string, breakType: number): {number}
   -- Creates a string search iterator using a collator and returns every match position. [may return nothing]
   FindStringMatches: function(text: string, pattern: string, strength: number): {number}
   -- Case-folds the characters in a string; case-folding is locale-independent and not context-sensitive. [may return nothing]
   FoldCase: function(text: string): string
   -- Formats a double as a localized currency value using the provided ISO 4217 currency code. [may return nothing]
   FormatCurrency: function(number: number, currencyCode: string): string
   -- Formats Unix time as localized date text using locale date patterns, symbols, style, and optional time zone. [may return nothing]
   FormatDate: function(unixTimeSeconds: number, style: number, timeZone: string): string
   -- Formats Unix time as localized date and time text using locale patterns, symbols, styles, and optional time zone. [may return nothing]
   FormatDateTime: function(unixTimeSeconds: number, dateStyle: number, timeStyle: number, timeZone: string): string
   -- Formats a double with locale number formatting using locale symbols, grouping, and the selected non-currency style. [may return nothing]
   FormatNumber: function(number: number, style: number): string
   -- Formats Unix time as localized time text using locale time patterns, symbols, style, and optional time zone. [may return nothing]
   FormatTime: function(unixTimeSeconds: number, style: number, timeZone: string): string
   -- Returns Unicode property values for the first code point in a string. [may return nothing]
   GetCharacterProperties: function(text: string): CharacterProperties
   -- Returns the number of fraction digits that should be displayed for the given currency. [may return nothing]
   GetCurrencyFractionDigits: function(currencyCode: string): number
   -- Returns the display name for a currency in the given locale. [may return nothing]
   GetCurrencyName: function(currencyCode: string, nameStyle: number): string
   -- Gets the current locale used by C_Intl.
   GetCurrentLocale: function(): string
   -- Gets a display name suitable for the specified locale. [may return nothing]
   GetDisplayName: function(displayLocale: string): string
   -- Transforms a string into a collation sort key. [may return nothing]
   GetSortKey: function(text: string, strength: number): string
   -- Tests if the string is normalized according to the specified normalization form.
   IsNormalized: function(text: string, form: number): boolean
   -- Counts character break boundaries in UTF-8 text. [may return nothing]
   Length: function(text: string): number
   -- Writes the normalized form of the source string to the destination string. [may return nothing]
   Normalize: function(text: string, form: number): string
   -- Parses an entire localized currency string into a double amount and ISO 4217 currency code. [may return nothing]
   ParseCurrency: function(text: string): CurrencyParseResult
   -- Parses an entire localized number string into a double using the selected non-currency number formatter. [may return nothing]
   ParseNumber: function(text: string, style: number): number
   -- Returns the keyword of the first plural rule that applies to a number. [may return nothing]
   SelectPlural: function(number: number, pluralType: number): string
   -- Lowercases the characters in a string; casing is locale-dependent and context-sensitive. [may return nothing]
   ToLower: function(text: string): string
   -- Titlecases a string using titlecase positions determined by the default Unicode algorithm. [may return nothing]
   ToTitle: function(text: string): string
   -- Uppercases the characters in a string; casing is locale-dependent and context-sensitive. [may return nothing]
   ToUpper: function(text: string): string
   -- Applies a locale transform to the current locale and returns the transformed locale string. [may return nothing]
   TransformLocale: function(transform: number): string
   -- Opens a system transliterator by ID and transliterates the text in place. [may return nothing]
   Transliterate: function(text: string, transliteratorID: string): string
end
