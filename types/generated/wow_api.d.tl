global record C_ActionBar
   -- Used in conjunction with ActionRangeCheckUpdate to inform the UI when an action goes in or out of range with its current target.
   EnableActionRangeCheck: function(actionID: number, enable: boolean)
   -- Returns the list of action bar slots that contain the Assisted Combat action spell. [may return nothing]
   FindAssistedCombatActionButtons: function(setToSearch?: number): {number}
   -- [may return nothing]
   FindFlyoutActionButtons: function(flyoutID: number, setToSearch?: number): {number}
   -- [may return nothing]
   FindPetActionButtons: function(petActionID: number, setToSearch?: number): {number}
   -- Returns the list of action bar slots that contain a specified spell. [may return nothing]
   FindSpellActionButtons: function(spellID: number | string, setToSearch?: number): {number}
   -- Force updates some internals for an action button slot.
   ForceUpdateAction: function(slotID: number, suppressEvents?: boolean)
   GetActionAutocast: function(actionID: number): boolean, boolean
   GetActionBarPage: function(): number
   -- Returns a duration object describing the active recharge time for an action.
   GetActionChargeDuration: function(actionID: number): any
   GetActionCharges: function(actionID: number): SpellChargeInfo
   GetActionCooldown: function(actionID: number): SpellCooldownInfo
   -- Returns a duration object describing the active cooldown duration for an action.
   GetActionCooldownDuration: function(actionID: number, ignoreGCD?: boolean): any
   -- Depending on the action type, return a string that is either the use count or number of charges. If value is beyond the display count parameter, returns the replacementString (defaults to '*').
   GetActionDisplayCount: function(actionID: number, maxDisplayCount?: number, replacementString?: string): string
   -- Returns a duration object describing the active loss of control cooldown duration for an action.
   GetActionLossOfControlCooldownDuration: function(actionID: number): any
   GetActionLossOfControlCooldownInfo: function(actionID: number): SpellLossOfControlInfo
   -- [may return nothing]
   GetActionText: function(actionID: number): string
   GetActionTexture: function(actionID: number): integer
   GetActionUseCount: function(actionID: number): number
   GetBonusBarIndex: function(): number
   -- [nilable: bonusBarIndex]
   GetBonusBarIndexForSlot: function(slotID: number): number
   GetBonusBarOffset: function(): number
   GetExtraBarIndex: function(): number
   -- [nilable: onEquipSpellID]
   GetItemActionOnEquipSpellID: function(actionID: number): number
   GetMultiCastBarIndex: function(): number
   GetOverrideBarIndex: function(): number
   -- [nilable: textureFileID]
   GetOverrideBarSkin: function(): integer
   -- [may return nothing]
   GetPetActionPetBarIndices: function(petActionID: number, setToSearch?: number): {number}
   -- [nilable: quality]
   GetProfessionQuality: function(actionID: number): number
   -- [nilable: info]
   GetProfessionQualityInfo: function(actionID: number): CraftingQualityInfo
   GetSpell: function(actionID: number): number
   GetTempShapeshiftBarIndex: function(): number
   GetVehicleBarIndex: function(): number
   -- Returns true if an actionbar slot is populated with an action.
   HasAction: function(actionID: number): boolean
   HasAssistedCombatActionButtons: function(setToSearch?: number): boolean
   HasBonusActionBar: function(): boolean
   HasExtraActionBar: function(): boolean
   HasFlyoutActionButtons: function(flyoutID: number, setToSearch?: number): boolean
   HasOverrideActionBar: function(): boolean
   HasPetActionButtons: function(petActionID: number, setToSearch?: number): boolean
   HasPetActionPetBarIndices: function(petActionID: number, setToSearch?: number): boolean
   HasRangeRequirements: function(actionID: number): boolean
   HasSpellActionButtons: function(spellID: number | string, setToSearch?: number): boolean
   HasTempShapeshiftActionBar: function(): boolean
   HasVehicleActionBar: function(): boolean
   -- [nilable: isInRange]
   IsActionInRange: function(actionID: number, target?: string): boolean
