global record NumberAbbrevOptions
   -- Order these from largest to smallest. [nilable]
   breakpointData: {NumberAbbreviationBreakpoint}
   -- Locale controls whether standard asian abbreviation data will be used along with a small change in behavior for large number abbreviation when fractionDivisor is greater than zero. [nilable]
   locale: string
   -- Provides a cached config object for optimal performance when calling abbreviation functions multiple times with the same options. [nilable]
   config: any
end
global record NumberAbbreviationBreakpoint
   -- Breakpoints should generally be specified as pairs, with one at the named order (1,000) with fractionDivisor = 10, and one a single order higher (eg. 10,000) with fractionDivisor = 1., This ruleset means numbers like '1234' will be abbreviated to '1.2k' and numbers like '12345' to '12k'.
   breakpoint: number
   -- Abbreviation name to be looked up as a global string.
   abbreviation: string
   -- significandDivisor and fractionDivisor should multiply such that they become equal to a named order of magnitude, such as thousands or  millions.
   significandDivisor: number
   fractionDivisor: number
   -- Defaults to true. Set to false to skip the global string lookup and use the raw abbreviation string when formatting results
   abbreviationIsGlobal: boolean
end
global record NumericRuleFormatBreakpoint
   -- Minimum input value that this rule applies to.
   threshold: number
   -- If specified, the input value is rounded to multiples of this step before processing. [nilable]
   step: number
   -- If specified, the rounding mode to apply to the step.
   rounding: number
   -- If specified, clamps the input value to this value if lesser after rounding. [nilable]
   min: number
   -- If specified, clamps the input value to this value if greater after rounding. [nilable]
   max: number
   -- The format string to apply at this threshold. If no components are specified, this can include at-most one numeric format specifier - else, should contain an equal number of format specifiers to elements in the components array.
   format: string
   -- Vector of component descriptions for this rule. [nilable]
   components: {NumericRuleFormatComponent}
end
global record NumericRuleFormatComponent
   -- If specified, divide the value by this amount and use the resulting quotient. This is applied before modulo division. [nilable]
   div: number
   -- If specified, divide the value by this amount and use the resulting remainder. This is applied after quotient division. [nilable]
   mod: number
   -- If specified, round the value to multiples of this step. This is applied after all division. [nilable]
   step: number
   -- If specified, rounding mode to apply to the step.
   rounding: number
end
