------------------------------------------------------------------------------
-- Widgets (hierarchy from Ketho, methods from Blizzard Simple*API docs)
------------------------------------------------------------------------------
global interface FrameScriptObject
   -- Adds access restrictions to a script object, preventing it from being used in API calls when enforced.
   AddAccessRestrictions: function(self, restrictions: number)
   -- Adds forbidden aspects to a script object, restricting access to various functionalities such as script bindings.
   AddForbiddenAspects: function(self, aspects: number)
   AddSecretAspect: function(self, aspect: number)
   -- Returns whether the current Lua execution context has permission to access this object.
   CanBeAccessedInContext: function(self): boolean
   -- Returns the mask of all access restrictions applied to this object.
   GetAccessRestrictions: function(self): number
   -- Returns the mask of all forbidden aspects applied to this object.
   GetForbiddenAspects: function(self): number
   -- Returns the mask of all forbidden aspects applied to this object that can propagate to others.
   GetInheritableForbiddenAspects: function(self, path: number): number
   GetName: function(self): string
   GetObjectTable: function(self): FrameScriptObject
   GetObjectType: function(self): string
   -- Returns whether this object has any access constraints that may limit access from some Lua execution contexts.
   HasAccessConstraints: function(self): boolean
   -- Returns true if this object has any of the supplied access restrictions applied.
   HasAnyAccessRestrictions: function(self, restrictions?: number): boolean
   -- Returns true if this object has any of the supplied forbidden aspects added.
   HasAnyForbiddenAspects: function(self, aspects?: number): boolean
   HasAnySecretAspect: function(self): boolean
   HasSecretAspect: function(self, aspect: number): boolean
   HasSecretValues: function(self): boolean
   -- Returns whether this object has been explicitly marked as forbidden.
   IsForbidden: function(self): boolean
   IsObjectType: function(self, objectType: string): boolean
   IsPreventingSecretValues: function(self): boolean
   SetForbidden: function(self)
   -- Reset all script accessible values to their default values. If possible, clears secret states. [protected]
   SetToDefaults: function(self)
   -- (Ketho)
   SetPreventSecretValues: function(self, preventSecretValues: boolean)
end
global interface Object is FrameScriptObject
   ClearParentKey: function(self)
   GetDebugName: function(self, preferParentKey?: boolean): string
   GetParent: function(self): FrameScriptObject
   GetParentKey: function(self): string
   SetParentKey: function(self, parentKey: string, clearOtherKeys?: boolean)
end
global interface ScriptObject
   SetScript: function(self, scriptType: ScriptTypeNoArgs, handler: function(frame: self))
   HookScript: function(self, scriptType: ScriptTypeNoArgs, handler: function(frame: self))
   GetScript: function(self, scriptType: ScriptTypeNoArgs): function(frame: self)
   SetScript: function(self, scriptType: ScriptTypeMotion, handler: function(frame: self, motion: boolean))
   HookScript: function(self, scriptType: ScriptTypeMotion, handler: function(frame: self, motion: boolean))
   GetScript: function(self, scriptType: ScriptTypeMotion): function(frame: self, motion: boolean)
   SetScript: function(self, scriptType: ScriptTypeMouseButton, handler: function(frame: self, button: string))
   HookScript: function(self, scriptType: ScriptTypeMouseButton, handler: function(frame: self, button: string))
   GetScript: function(self, scriptType: ScriptTypeMouseButton): function(frame: self, button: string)
   SetScript: function(self, scriptType: ScriptTypeClick, handler: function(frame: self, button: string, down: boolean))
   HookScript: function(self, scriptType: ScriptTypeClick, handler: function(frame: self, button: string, down: boolean))
   GetScript: function(self, scriptType: ScriptTypeClick): function(frame: self, button: string, down: boolean)
   SetScript: function(self, scriptType: ScriptTypeWheel, handler: function(frame: self, delta: number))
   HookScript: function(self, scriptType: ScriptTypeWheel, handler: function(frame: self, delta: number))
   GetScript: function(self, scriptType: ScriptTypeWheel): function(frame: self, delta: number)
   SetScript: function(self, scriptType: ScriptTypeEvent, handler: function(frame: self, event: string, ...: any))
   HookScript: function(self, scriptType: ScriptTypeEvent, handler: function(frame: self, event: string, ...: any))
   GetScript: function(self, scriptType: ScriptTypeEvent): function(frame: self, event: string, ...: any)
   SetScript: function(self, scriptType: ScriptTypeUpdate, handler: function(frame: self, elapsed: number))
   HookScript: function(self, scriptType: ScriptTypeUpdate, handler: function(frame: self, elapsed: number))
   GetScript: function(self, scriptType: ScriptTypeUpdate): function(frame: self, elapsed: number)
   SetScript: function(self, scriptType: ScriptTypeSize, handler: function(frame: self, width: number, height: number))
   HookScript: function(self, scriptType: ScriptTypeSize, handler: function(frame: self, width: number, height: number))
   GetScript: function(self, scriptType: ScriptTypeSize): function(frame: self, width: number, height: number)
   SetScript: function(self, scriptType: ScriptTypeKey, handler: function(frame: self, key: string))
   HookScript: function(self, scriptType: ScriptTypeKey, handler: function(frame: self, key: string))
   GetScript: function(self, scriptType: ScriptTypeKey): function(frame: self, key: string)
   SetScript: function(self, scriptType: ScriptTypeValue, handler: function(frame: self, value: number, userInput: boolean))
   HookScript: function(self, scriptType: ScriptTypeValue, handler: function(frame: self, value: number, userInput: boolean))
   GetScript: function(self, scriptType: ScriptTypeValue): function(frame: self, value: number, userInput: boolean)
   SetScript: function(self, scriptType: ScriptTypeText, handler: function(frame: self, userInput: boolean))
   HookScript: function(self, scriptType: ScriptTypeText, handler: function(frame: self, userInput: boolean))
   GetScript: function(self, scriptType: ScriptTypeText): function(frame: self, userInput: boolean)
   SetScript: function(self, scriptType: ScriptTypeHyperlink, handler: function(frame: self, link: string, text: string, region: Region, left: number, bottom: number, width: number, height: number))
   HookScript: function(self, scriptType: ScriptTypeHyperlink, handler: function(frame: self, link: string, text: string, region: Region, left: number, bottom: number, width: number, height: number))
   GetScript: function(self, scriptType: ScriptTypeHyperlink): function(frame: self, link: string, text: string, region: Region, left: number, bottom: number, width: number, height: number)
   HasScript: function(self, scriptType: string): boolean
end
