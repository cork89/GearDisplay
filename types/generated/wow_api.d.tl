global record CustomAuraButtonApplicationBarOptions
   -- The maximum number of aura applications represented by the bar.
   maxApplications: number
   -- The minimum number of aura applications represented by the bar.
   minApplications: number
   -- Optional interpolation method used when updating the bar value. [nilable]
   interpolation: number
end
global record CustomAuraButtonApplicationCountOptions
   -- Optional formatter used to display aura application counts. [nilable]
   formatter: any
end
global record CustomAuraButtonCasterNameOptions
   -- If true, append realm names to the displayed string.
   showRealmName: boolean
   -- If true, apply class coloring to the text.
   useClassColors: boolean
end
global record CustomAuraButtonDispelTypeTextOptions
   -- Shows the dispel type text for harmful auras.
   showWhenHarmful: boolean
   -- Shows the dispel type text for helpful auras.
   showWhenHelpful: boolean
   -- Shows the dispel type text for auras that do not have a dispel type.
   showWithoutDispelType: boolean
   -- Optional map of dispel type names to custom texts. An empty key can be used for auras without a dispel type. [nilable]
   customDispelTextMap: {string}
end
global record CustomAuraButtonDispelTypeTextureAsset
   -- The texture file or atlas to use.
   asset: integer | string
   -- Resizes the texture to the atlas dimensions. Ignored when asset does not name an atlas.
   useAtlasSize: boolean
   -- Optional texture coordinates used when asset does not name an atlas. [nilable]
   texCoords: CustomAuraButtonDispelTypeTextureTexCoords
end
global record CustomAuraButtonDispelTypeTextureOptions
   -- Shows the dispel type texture always, ignoring all other criteria.
   showAlways: boolean
   -- Shows the dispel type texture for harmful auras.
   showWhenHarmful: boolean
   -- Shows the dispel type texture for helpful auras.
   showWhenHelpful: boolean
   -- Shows the dispel type texture for auras that do not have a dispel type.
   showWithoutDispelType: boolean
   -- Restricts display of the dispel type texture to either stealable or non-stealable auras. If omitted, the dispel type texture may be shown for both. [nilable]
   stealableFilter: number
   -- The texture style to use.
   style: number
   -- Optional map of dispel type names to custom texture assets. The "None" key represents auras without a dispel type. Only applies when using the CustomAsset style. [nilable]
   customDispelAssetMap: {CustomAuraButtonDispelTypeTextureAsset}
   -- Optional map of dispel type names to custom vertex colors. The "None" key represents auras without a dispel type. [nilable]
   customDispelColorMap: {ColorMixin}
   -- Optional curve used to determine vertex colors from the aura's dispel type. [nilable]
   customDispelColorCurve: any
end
global record CustomAuraButtonDispelTypeTextureTexCoords
   left: number
   right: number
   top: number
   bottom: number
end
global record CustomAuraButtonDurationBarOptions
   -- The interpolation method used when updating the duration bar. [nilable]
   interpolation: number
   -- The direction in which the duration bar progresses. [nilable]
   direction: number
end
global record CustomAuraButtonDurationTextOptions
   -- Optional duration text binding to use. The binding is copied before being associated with the aura button. [nilable]
   binding: any
   -- Optional formatter used to display remaining duration values. Ignored if textFormat is specified. [nilable]
   textFormatter: any
   -- Optional text format configuration applied to the duration text binding. Overrides textFormatter when specified. [nilable]
   textFormat: DurationTextBindingFormatOptions
   -- Optional text color configuration applied to the duration text binding. [nilable]
   textColor: DurationTextBindingColorOptions
end
