-- LuaMathExtensionsDocumentation.lua
global record math
   -- Clamps a value to the inclusive range defined by the minimum and maximum values.
   clamp: function(value: number, minimum: number, maximum: number): number
   -- Returns whether a value is finite.
   isfinite: function(value: number): boolean
   -- Returns whether a value is positive or negative infinity.
   isinf: function(value: number): boolean
   -- Returns whether a value is NaN.
   isnan: function(value: number): boolean
   -- Linearly interpolates between two values.
   lerp: function(startValue: number, endValue: number, amount: number): number
   -- Returns the relative position of a value within a range, where the minimum maps to 0 and the maximum maps to 1.
   normalize: function(value: number, minimum: number, maximum: number): number
   -- Maps a value from one range to the corresponding position in another range.
   remap: function(value: number, sourceMinimum: number, sourceMaximum: number, destinationMinimum: number, destinationMaximum: number): number
   -- Rounds a value to the specified number of decimal places, with halfway values rounded away from zero.
   round: function(value: number, decimalPlaces?: number): number
   -- Clamps a value to the inclusive range [0, 1].
   saturate: function(value: number): number
   -- Returns -1 for negative values, 0 for zero, and 1 for positive values.
   sign: function(value: number): number
   -- Wraps a value into the half-open range [minimum, maximum).
   wrap: function(value: number, minimum: number, maximum: number): number
end
-- LuaStringExtensionsDocumentation.lua
global record string
   -- Returns a string with all bytes in the specified character set removed from the start.
   ltrim: function(str: string, characters?: string): string
   -- Returns a string with all bytes in the specified character set removed from the end.
   rtrim: function(str: string, characters?: string): string
   -- Returns true if a string contains the specified literal substring.
   contains: function(str: string, substring: string): boolean
   -- Returns true if a string ends with the specified suffix.
   endswith: function(str: string, suffix: string): boolean
   -- Returns true if a string starts with the specified prefix.
   startswith: function(str: string, prefix: string): boolean
   -- Returns a string with all bytes in the specified character set removed from both ends.
   trim: function(str: string, characters?: string): string
end
-- LuaTableExtensionsDocumentation.lua
global record table
   -- Returns true if any value in the table compares equal to the specified value.
   contains: function(table: {any:any}, value?: any): boolean
   -- Returns the number of entries in the table.
   count: function(table: {any:any}): number
   -- Creates an empty table with storage preallocated for the specified number of array and non-array entries.
   create: function(arraySizeHint: number, nodeSizeHint?: number): {any:any}
   -- Returns the first integer index whose value compares equal to the specified value, searching consecutively from index 1 until the first nil value. [nilable: index]
   indexof: function(table: {any:any}, value?: any): number
   -- Marks a supplied table as frozen, preventing any modifications to its contents, or replacement of its metatable. If the table has a pre-existing metatable with a '__newindex' table or function, assignments will pass through without raising errors. For tainted code, only tables created by the same addon making this function call are permitted to be frozen.
   freeze: function(table: {any:any}): {any:any}
   -- Returns an array containing the keys of the specified table.
   keys: function(table: {any:any}): any
   -- Returns detailed information about the number and distribution of entries in the table.
   getcountinfo: function(table: {any:any}): number, number, number
   -- Returns an array containing the values of the specified table.
   values: function(table: {any:any}): any
   -- Returns true if the table contains no entries.
   isempty: function(table: {any:any}): boolean
   -- Returns true if a table has been marked as frozen.
   isfrozen: function(table: {any:any}): boolean
   -- Removes the value at the specified integer index by replacing it with the last value in the array and shortening the array by one element. The order of values in the array is not preserved. [nilable: value]
   removeunordered: function(table: {any:any}, index?: number): any
   -- Removes all values equal to the specified value from the array portion of a table.
   removevalue: function(table: {any:any}, value?: any): number
end

