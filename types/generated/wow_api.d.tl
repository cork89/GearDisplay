   SetCountdownFont: function(self, fontName: string)
   SetCountdownFormatter: function(self, formatter?: any)
   -- Sets the threshold below which cooldown numbers are displayed as a decimal value with one place for milliseconds (eg. '8.7').
   SetCountdownMillisecondsThreshold: function(self, seconds: any)
