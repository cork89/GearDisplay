   TryRenameNeighborhood: function(neighborhoodName: string)
   ValidateCreateGuildNeighborhoodSize: function()
   ValidateNeighborhoodName: function(neighborhoodName: string)
   VisitHouse: function(neighborhoodGUID: string, houseGUID: string, plotID: number)
end
-- HousingBasicModeUIDocumentation.lua
global record C_HousingBasicMode
   -- Cancels all in-progress editing of the selected target, which will reset any unsaved changes and deselect the active target; Un-placed decor will be returned to the house chest
   CancelActiveEditing: function()
   -- Attempt to save the changes made to the currently selected decor instance
   CommitDecorMovement: function()
   -- Attempt to save the changes made to the House Exterior's position within the plot
   CommitHouseExteriorPosition: function()
   FinishPlacingNewDecor: function()
   -- Returns info for the placed decor instance currently being hovered, if there is one [nilable: info]
   GetHoveredDecorInfo: function(): HousingDecorInstanceInfo
   -- Returns info for the decor instance that's currently selected, if there is one [nilable: info]
   GetSelectedDecorInfo: function(): HousingDecorInstanceInfo
   -- Returns true if a decor instance is currently selected and being dragged
   IsDecorSelected: function(): boolean
   -- When free place is enabled, collision checks while dragging decor/the house exterior are ignored
   IsFreePlaceEnabled: function(): boolean
   IsGridSnapEnabled: function(): boolean
   IsGridVisible: function(): boolean
   -- Returns true if the house's exterior is currently being hovered
   IsHouseExteriorHovered: function(): boolean
   -- Returns true if the house's exterior is currently selected and being moved
   IsHouseExteriorSelected: function(): boolean
   -- Returns true if a placed decor instance is currently being hovered
   IsHoveringDecor: function(): boolean
   IsPlacingNewDecor: function(): boolean
   -- Attempt to return the currently selected decor instance back to the house chest
   RemoveSelectedDecor: function()
   -- Rotates the currently selected decor along a single axis; For wall decor, rotates such that the object stays flat against its current wall; For all other decor, rotates around the Z (vertical) axis
   RotateDecor: function(rotDegrees: number)
   -- Rotates the House Exterior around the Z (vertical) axis
   RotateHouseExterior: function(rotDegrees: number)
   -- Set whether free place is enabled; When free place is enabled, collision checks while dragging decor/the house exterior are ignored
   SetFreePlaceEnabled: function(freePlaceEnabled: boolean)
   SetGridSnapEnabled: function(isGridSnapEnabled: boolean)
   SetGridVisible: function(gridVisible: boolean)
   StartPlacingNewDecor: function(catalogEntryVariantID: HousingCatalogEntryVariantID)
   StartPlacingPreviewDecor: function(decorRecordID: number, bundleCatalogShopProductID?: number)
end
-- HousingBlueprintUIDocumentation.lua
global record C_HousingBlueprint
   -- Returns true if the specific room is allowed to be exported
   CanExportRoom: function(roomGUID: string): boolean
   -- Returns true if the player's current location is a valid place to attempt to export a specific kind of blueprint
   CanExportTypeFromCurrentLocation: function(type_: number): boolean
   -- Returns true if the player's current location is a valid place to attempt to import a specific kind of blueprint
   CanImportTypeFromCurrentLocation: function(type_: number): boolean
   -- Delete the specified owned blueprint; Listen for HousingBlueprintDeleteSuccess and HousingBlueprintDeleteFailure for results
   DeleteBlueprint: function(blueprintID: number)
   -- Saves out a new Blueprint of the specified type, using the specified name, if available, based on where the player is currently standing (see GetExportAvailability); Listen for HousingBlueprintExportSuccess and HousingBlueprintExportFailure for results
   ExportBlueprint: function(type_: number, name: string)
   -- Saves out a new Blueprint of the specified room, using the specified name, if available (see GetExportAvailability); Listen for HousingBlueprintExportSuccess and HousingBlueprintExportFailure for results
   ExportRoomBlueprint: function(name: string, roomGUID: string)
   -- [may return nothing]
   GetBlueprintHyperlink: function(blueprintShareCode: string): string
   -- Returns what type of Blueprint the specified code is for; Will return HousingBlueprintType.None if code is invalid; Does NOT check whether the shareCode actually matches up to a real valid Blueprint
   GetBlueprintTypeForCode: function(shareCode: string): number
   -- Returns success if the player can currently export Blueprints, or a specific error type (ex: invalid location or permissions)
   GetExportAvailability: function(): number
   -- Returns success if Blueprints as a feature is currently enabled and available
   GetFeatureAvailability: function(): number
   -- Returns success if the player can currently import Blueprints, or a specific error type (ex: invalid location or permissions)
   GetImportAvailability: function(): number
   -- Imports the specified blueprint, if available (see GetImportAvailability and CanImportTypeFromCurrentLocation); Listen for HousingBlueprintImportSuccess and HousingBlueprintImportFailure for results
   ImportBlueprint: function(shareCode: string)
   -- Returns true if the string matches the valid expected format for a Blueprint Share Code; Does NOT check whether the shareCode actually matches up to a real valid Blueprint
   IsShareCodeValid: function(shareCode: string): boolean
   -- Rename the specified owned blueprint to the specified name; Listen for HousingBlueprintRenameSuccess and HousingBlueprintRenameFailure for results
   RenameBlueprint: function(blueprintID: number, newName: string)
   -- Request the full list of all of the player's Blueprints; This is async, either the HOUSING_BLUEPRINT_COLLECTION_RECEIVED or HOUSING_BLUEPRINT_COLLECTION_FAILURE event will eventually be fired as a result
   RequestBlueprintCollection: function()
   -- Request the full contents of a specific Blueprint, in context of the current owned plot or house (if any); This is async as content info includes dynamic data from the server, either the HOUSING_BLUEPRINT_CONTENTS_RECEIVED or HOUSING_BLUEPRINT_CONTENTS_FAILURE event will eventually be fired as a result; Calling this again before a prior request has finished will cancel the prior request
   RequestBlueprintContents: function(shareCode: string)
   -- Request the full contents of a specific Blueprint, either in context of a specific owned House or plot, or explicitly outside of any specific context; Typically used to update missing requirement info from previously-retrieved contents; See RequestBlueprintContents for other notes
   RequestBlueprintContentsForContext: function(shareCode: string, optionalHouseGUID?: string)
   -- Start the process of importing a Room Blueprint. This will lead to Layout Mode being opened, so the player can then select an available door to attach the room to
   StartImportRoomBlueprint: function(shareCode: string)
   -- [may return nothing]
   UpdateBlueprintStringFromInput: function(inputShareCode: string): string
end
-- HousingCatalogUIDocumentation.lua
global record C_HousingCatalog
   -- Creates a new instance of a HousingCatalog searcher; This can be used to asynchronously search/filter the HousingCatalog without affecting/being restricted by the filter state of other Housing Catalog UI displays
   CreateCatalogSearcher: function(): any
   DeletePreviewCartDecor: function(decorGUID: string)
   -- Attempt to delete the entry from storage
   DestroyEntry: function(entryVariantID: HousingCatalogEntryVariantID, destroyAll: boolean)
   GetAllFilterTagGroups: function(): {HousingCatalogFilterTagGroupInfo}
   -- Returns variant info for all variants of a given catalog entry; Variants represent different visual modifications of the same base entry (ex: dyed versions)
   GetAllVariantInfosForEntry: function(entryID: HousingCatalogEntryID): {HousingCatalogEntryVariantInfo}
   -- [nilable: bundleInfo]
   GetBundleInfo: function(bundleCatalogShopProductID: number): HousingBundleInfo
   GetCartSizeLimit: function(): number
   -- If found, returns the names of the parent category and the specified subcategory [may return nothing]
   GetCatalogCategoryAndSubcategoryNames: function(subcategoryID: number): string, string
   -- [nilable: info]
   GetCatalogCategoryInfo: function(categoryID: number): HousingCatalogCategoryInfo
   -- [nilable: info]
   GetCatalogEntryInfo: function(entryID: HousingCatalogEntryID): HousingCatalogEntryInfo
   -- [nilable: info]
   GetCatalogEntryInfoByItem: function(itemInfo: number | string): HousingCatalogEntryInfo
   -- [nilable: info]
   GetCatalogEntryInfoByRecordID: function(entryType: number, recordID: number): HousingCatalogEntryInfo
   -- [nilable: refundTimeStamp]
   GetCatalogEntryRefundTimeStampByRecordID: function(entryType: number, recordID: number): number
   -- [nilable: info]
   GetCatalogEntryVariantInfo: function(entryVariantID: HousingCatalogEntryVariantID): HousingCatalogEntryVariantInfo
   -- [nilable: info]
   GetCatalogSubcategoryInfo: function(subcategoryID: number): HousingCatalogSubcategoryInfo
   -- Returns the maximum total number of decor that can be in storage/in the house chest; Note that not all decor entries in storage count towards this limit (see GetDecorTotalOwnedCount)
   GetDecorMaxOwnedCount: function(): number
   GetDecorTotalOwnedCount: function(): number, number
   -- Returns the number of instances that can be to be destroyed in storage; These instances count towards the max storage limit
   GetDestroyableInstanceCount: function(entryVariantID: HousingCatalogEntryVariantID): number
   GetFeaturedBundles: function(): {HousingBundleInfo}
   GetFeaturedSmallProducts: function(): {HousingFeaturedSmallProductInfo}
   -- Returns market info for a specific decor. This is decor-only for now but should be extended to support entry type and recordID generically [nilable: marketInfo]
   GetMarketInfoForDecor: function(decorID: number): HousingMarketInfo
   HasFeaturedEntries: function(): boolean
   HousingMarketActionAddToCart: function(productID: number, withPreview: boolean)
   HousingMarketActionClearCart: function()
   HousingMarketActionRemoveFromCart: function(productID: number)
   HousingMarketActionViewBundle: function(productID: number)
   HousingMarketActionViewInStore: function(productID: number)
   IsPreviewCartItemShown: function(decorGUID: string): boolean
   PromotePreviewDecor: function(decorID: number, previewDecorGUID: string): boolean
   RequestHousingMarketInfoRefresh: function()
   RequestHousingMarketRefundInfo: function()
   SearchCatalogCategories: function(searchParams: HousingCategorySearchInfo): {number}
   SearchCatalogSubcategories: function(searchParams: HousingCategorySearchInfo): {number}
   SetPreviewCartItemShown: function(decorGUID: string, shown: boolean)
end
-- HousingCleanupModeUIDocumentation.lua
global record C_HousingCleanupMode
   -- [nilable: info]
   GetHoveredDecorInfo: function(): HousingDecorInstanceInfo
   IsHoveringDecor: function(): boolean
   RemoveSelectedDecor: function()
end
-- HousingCustomizeModeUIDocumentation.lua
global record C_HousingCustomizeMode
   -- If a dyeable decor is selected, applies a specific dye color in a specific slot as a preview; See CommitDyesForSelectedDecor to actually save applied dye changes
   ApplyDyeToSelectedDecor: function(dyeSlotID: number, dyeColorID?: number)
   -- If a decor is selected that supports pets, applies a specific petID to be shown on that decor
   ApplyPetToSelectedDecor: function(petID?: string, petBehavior: number)
   -- Attempt to apply a specific theme set (aka style) to all applicable room components in the current room
   ApplyThemeToRoom: function(themeSetID: number)
   -- Attempt to apply a specific theme set (aka style) to the currently selected room component only
   ApplyThemeToSelectedRoomComponent: function(themeSetID: number)
   -- Attempt to apply a specific wallpaper (aka material/texture) to all applicable room components in the current room
   ApplyWallpaperToAllWalls: function(roomComponentTextureRecID: number)
   -- Attempt to apply a specific wallpaper (aka material/texture) to the currently selected room component only
   ApplyWallpaperToSelectedRoomComponent: function(roomComponentTextureRecID: number)
   -- Cancels all in-progress editing of the selected target, which will reset any unapplied customization changes and deselect the active target
   CancelActiveEditing: function()
   -- Clears all previewed dye changes on the selected decor; Does not clear any already saved dyes that were previously applied
   ClearDyesForSelectedDecor: function()
   -- Deselect the currently selected room component, if there is one
   ClearTargetRoomComponent: function()
   -- Attempt to save all previewed dye changes made to the selected decor
   CommitDyesForSelectedDecor: function(): boolean
   -- Returns info for the placed decor instance currently being hovered, if there is one [nilable: info]
   GetHoveredDecorInfo: function(): HousingDecorInstanceInfo
   -- Returns info for the room component currently being hovered, if there is one [nilable: info]
   GetHoveredRoomComponentInfo: function(): HousingRoomComponentInstanceInfo
   -- If a dyeable decor instance is selected, returns how many dye slots would be cleared on applying all currently previewed dye changes
   GetNumDyesToRemoveOnSelectedDecor: function(): number
   -- If a dyeable decor instance is selected, returns how many dye items would be spent on applying all currently previewed dye changes
   GetNumDyesToSpendOnSelectedDecor: function(): number
   -- If a dyeable decor instance is selected, returns info structs for each new/changed dye currently being previewed
   GetPreviewDyesOnSelectedDecor: function(): {PreviewDyeSlotInfo}
   -- Returns a list of ids for the dyes most recently applied by the player, if any
   GetRecentlyUsedDyes: function(): {number}
   -- Returns a list of ids for the theme sets (aka styles) most recently applied by the player, if any
   GetRecentlyUsedThemeSets: function(): {number}
   -- Returns a list of ids for the wallpapers most recently applied by the player, if any
   GetRecentlyUsedWallpapers: function(): {number}
   -- Returns info for the decor instance that's currently selected, if there is one [nilable: info]
   GetSelectedDecorInfo: function(): HousingDecorInstanceInfo
   -- If a decor is selected that supports pets, gets petID and behavior type from decor [nilable: petID]
   GetSelectedDecorPetInfo: function(): string, number
   -- Returns info for the currently selected room component, if there is one [nilable: info]
   GetSelectedRoomComponentInfo: function(): HousingRoomComponentInstanceInfo
   -- Returns the name of the specified theme set (aka style) if it exists [nilable: name]
   GetThemeSetInfo: function(themeSetID: number): string
   -- Get all wallpapers (aka materials/textures) available for the selected room component type, if any
   GetWallpapersForRoomComponentType: function(type_: number): {RoomComponentWallpaper}
   -- Returns true if a decor instance is currently selected for customization
   IsDecorSelected: function(): boolean
   -- Returns true if the entry door of the house's exterior is currently being hovered
   IsHouseExteriorDoorHovered: function(): boolean
   -- Returns true if a placed decor instance is currently being hovered
   IsHoveringDecor: function(): boolean
   -- Returns true if a room component is currently being hovered
   IsHoveringRoomComponent: function(): boolean
   -- Returns true if a room component is currently selected for customization
   IsRoomComponentSelected: function(): boolean
   -- Check whether a specific room component supports a particular variant; What kind of id or enum 'variant' equates to is complicated, as it depends on the component type
   RoomComponentSupportsVariant: function(componentID: number, variant: number): boolean
   -- Check whether a specific room component, within a specific room, supports a particular doorType
   RoomConnectionSupportsDoorType: function(roomGUID: string, componentID: number, newDoortype: number): boolean
   -- Attempt to set a specific ceiling component, within a specific room, to a specific new ceiling type
   SetRoomComponentCeilingType: function(roomGUID: string, componentID: number, ceilingType: number)
   -- Attempt to set a specific door component, within a specific room, to a specific new door type
   SetRoomComponentDoorType: function(roomGUID: string, componentID: number, newDoortype: number)
end
-- HousingDecorUIDocumentation.lua
global record C_HousingDecor
   -- Returns true if any decor objects are placed in a given room
   AnyDecorPlacedInRoom: function(roomGUID: string): boolean
   -- Cancels all in-progress editing of the selected target, which will reset any unsaved changes and deselect the active target
   CancelActiveEditing: function()
   -- Attempt to save the changes made to the currently selected decor instance
   CommitDecorMovement: function()
   EnterPreviewState: function()
   ExitPreviewState: function()
   -- Returns the interior and exterior max decor placement budgets for the current owned house interior or plot; Can be increased via house level [nilable: interiorMaxBudgets] [nilable: exteriorMaxBudgets]
   GetAllMaxPlacementBudgets: function(): {number}, {number}
   -- Placed Decor List APIs currently restricted due to being potentially very expensive operations, may be reworked & opened up in the future
   GetAllPlacedDecor: function(): {HousingDecorInstanceListEntry}
   -- Returns how much of the interior and exterior placement budgets for the current owned house interior or plot's decor budget have been spent [nilable: interiorSpentBudgets] [nilable: exteriorSpentBudgets]
   GetAllSpentPlacementBudgets: function(): {number}, {number}
   -- Returns pet name for the placed decor instance associated with the passed Decor GUID, if there is one [nilable: name]
   GetDecorAssignedPetName: function(decorGUID: string): string
   GetDecorCanAttachPet: function(decorID: number): boolean
   -- [may return nothing]
   GetDecorHyperlink: function(decorID: number): string
   -- [may return nothing]
   GetDecorIcon: function(decorID: number): integer
   -- Returns info for the placed decor instance associated with the passed Decor GUID, if there is one [nilable: info]
   GetDecorInstanceInfoForGUID: function(decorGUID: string): HousingDecorInstanceInfo
   -- [may return nothing]
   GetDecorName: function(decorID: number): string
   -- Returns info for the placed decor instance currently being hovered, if there is one [nilable: info]
   GetHoveredDecorInfo: function(): HousingDecorInstanceInfo
   -- Returns the max pet decor placement budget for the current owned house interior or plot [nilable: maxBudget]
   GetMaxPetPlacementBudget: function(): number
   -- Returns the max decor placement budget for the current owned house interior or plot; Can be increased via house level [nilable: maxBudget]
   GetMaxPlacementBudget: function(): number
   -- Returns the number of individual decor objects placed in the current house or plot; This is NOT the value used in placement budget calculations, see GetSpentPlacementBudget for that
   GetNumDecorPlaced: function(): number
   GetNumPreviewDecor: function(): number
   -- Returns info for the placed decor instance that's currently selected, if there is one [nilable: info]
   GetSelectedDecorInfo: function(): HousingDecorInstanceInfo
   -- Returns how much of the current owned house interior or plot's pet decor placement budget has been spent [nilable: totalCost]
   GetSpentPetPlacementBudget: function(): number
   -- Returns how much of the current owned house interior or plot's decor placement budget has been spent; Different kinds of decor take up different budget amounts, so this value isn't an individual decor count, see GetNumDecorPlaced for that [nilable: totalCost]
   GetSpentPlacementBudget: function(): number
   -- Returns whether there's a max decor placement budget available and active for the current player, in the current house interior or plot
   HasMaxPlacementBudget: function(): boolean
   -- Returns true if a placed decor instance is currently selected
   IsDecorSelected: function(): boolean
   IsGridVisible: function(): boolean
   -- Returns true if the entry door of the house's exterior is currently being hovered
   IsHouseExteriorDoorHovered: function(): boolean
   -- Returns true if the house's exterior is currently being hovered
   IsHouseExteriorHovered: function(): boolean
   -- Returns true if a placed decor instance is currently being hovered
   IsHoveringDecor: function(): boolean
   IsModeDisabledForPreviewState: function(mode: number): boolean
   IsPreviewState: function(): boolean
   -- Placed Decor List APIs currently restricted due to being potentially very expensive operations, may be reworked & opened up in the future
   RemovePlacedDecorEntry: function(decorGUID: string)
   -- Attempt to return the currently selected decor instance back to the house chest
   RemoveSelectedDecor: function()
   SetGridVisible: function(gridVisible: boolean)
   -- Placed Decor List APIs currently restricted due to being potentially very expensive operations, may be reworked & opened up in the future
   SetPlacedDecorEntryHovered: function(decorGUID: string, hovered: boolean)
   -- Placed Decor List APIs currently restricted due to being potentially very expensive operations, may be reworked & opened up in the future
   SetPlacedDecorEntrySelected: function(decorGUID: string, selected: boolean)
end
-- HousingExpertModeUIDocumentation.lua
global record C_HousingExpertMode
   -- Cancels all in-progress editing of the selected target, which will reset any unsaved changes and deselect the active target; Will not reset any already-applied changes
   CancelActiveEditing: function()
   -- Attempt to save the changes made to the currently selected decor instance
   CommitDecorMovement: function()
   -- Attempt to save the changes made to the House Exterior's position within the plot
   CommitHouseExteriorPosition: function()
   -- Returns info for the placed decor instance currently being hovered, if there is one [nilable: info]
   GetHoveredDecorInfo: function(): HousingDecorInstanceInfo
   -- Returns the currently active Expert submode, if there is one [nilable: activeSubMode]
   GetPrecisionSubmode: function(): number
   -- Returns the type of restriction currently active on the submode; Will return HousingExpertSubmodeRestriction:None if submode is not currently restricted
   GetPrecisionSubmodeRestriction: function(subMode: number): number
   -- Returns info for the placed decor instance that's currently selected, if there is one [nilable: info]
   GetSelectedDecorInfo: function(): HousingDecorInstanceInfo
   -- Returns true if a placed decor instance is currently selected
   IsDecorSelected: function(): boolean
   IsGridVisible: function(): boolean
   -- Returns true if the house's exterior is currently being hovered
   IsHouseExteriorHovered: function(): boolean
   -- Returns true if the house's exterior is currently selected
   IsHouseExteriorSelected: function(): boolean
   -- Returns true if a placed decor instance is currently being hovered
   IsHoveringDecor: function(): boolean
   -- Attempt to return the currently selected decor instance back to the house chest
   RemoveSelectedDecor: function()
   -- Reset the selected target's transform back to default values; This is NOT an undo, meaning it will completely reset the transform value to default, NOT just recently-made changes
   ResetPrecisionChanges: function(activeSubmodeOnly: boolean)
   -- In the rotation submode, swaps the selected axis to the next available one, in order of X -> Y -> Z (wrapping back around to X again, etc); If no axis is selected, selects the first available one, also in that order
   SelectNextRotationAxis: function()
   SetGridVisible: function(gridVisible: boolean)
   -- Sets a specific type of incremental change active or inactive; Whilever that type is active and target stays selected, incremental changes of that type will continue to be made every frame
   SetPrecisionIncrementingActive: function(incrementType: number, active: boolean)
   -- Activate a specific Expert submode
   SetPrecisionSubmode: function(subMode: number)
end
-- HousingInspectModeUIDocumentation.lua
global record C_HousingInspectMode
   -- Enters inspect mode, enabling decor inspection
   EnterInspectMode: function()
   -- Exits inspect mode, disabling decor inspection
   ExitInspectMode: function()
   -- Returns the GUID of the decor instance currently being hovered, if there is one
   GetHoveredDecorGUID: function(): string
   -- Returns true if a decor instance is currently being hovered in inspect mode
   IsHoveringDecor: function(): boolean
   -- Returns true if the player is currently in inspect mode
   IsInInspectMode: function(): boolean
end
-- HousingLayoutUIDocumentation.lua
global record C_HousingLayout
   AnyRoomsOnFloor: function(floor: number): boolean
   CanSetViewedFloor: function(floor: number): boolean
   CancelActiveLayoutEditing: function()
   ConfirmStairChoice: function(choice?: number)
   DeselectFloorplan: function()
   DeselectRoomOrDoor: function()
   GetBaseRoomFloor: function(): number
   GetHighestOccupiedFloorIndex: function(): number
   GetLowestOccupiedFloorIndex: function(): number
   GetNumActiveRooms: function(): number
   -- Returns the max room placement budget for the current owned house's interior; Can be increased via house level [nilable: placementBudget]
   GetRoomPlacementBudget: function(): number
   -- Returns the guid of the interior room the player is standing in, or nil if not currently standing in one [may return nothing]
   GetRoomPlayerIsIn: function(): string
   -- [may return nothing]
   GetSelectedBlueprintFloorplan: function(): number, string
   -- If a door is selected, returns its component id and the guid of the room it belongs to; Otherwise returns nothing [may return nothing]
   GetSelectedDoor: function(): number, string
   -- [nilable: roomID]
   GetSelectedFloorplan: function(): number
   -- If a Room is selected, returns the room's guid; Otherwise returns nothing [may return nothing]
   GetSelectedRoom: function(): string
   GetSelectedStairwellRoomCount: function(): number
   -- Returns how much of the current owned house's room placement budget has been spent; Different kinds of rooms take up different budget amounts, so this value isn't an individual room count, see GetNumActiveRooms for that [nilable: spentPlacementBudget]
   GetSpentPlacementBudget: function(): number
   GetViewedFloor: function(): number
   -- Returns true if any room, door, or floorplan is currently selected or being dragged
   HasAnySelections: function(): boolean
   -- Returns whether there's a max room placement budget available and active for the current player, in the current house's interior
   HasRoomPlacementBudget: function(): boolean
   HasSelectedBlueprintFloorplan: function(): boolean
   -- Returns true if a door component is currently selected
   HasSelectedDoor: function(): boolean
   HasSelectedFloorplan: function(): boolean
   -- Returns true if a room is selected, will NOT return true if a door is selected
   HasSelectedRoom: function(): boolean
   HasStairs: function(roomRecordID: number): boolean
   HasValidConnection: function(roomGUID: string, componentID: number, roomId: number): boolean
   IsBaseRoom: function(roomGUID: string): boolean
   IsDraggingRoom: function(): boolean, boolean
   -- Attempt to move the room currently being dragged to a specific connection point on a specific other room
   MoveDraggedRoom: function(sourceDoorIndex: number, destRoom: string, destDoorIndex: number)
   MoveLayoutCamera: function(direction: number, isPressed: boolean)
   -- Attempt to return a previously placed room to the House Chest
   RemoveRoom: function(roomGUID: string)
   -- Returns true of the provided roomGUID is a stairwell. Returns false if roomGUID is invalid
   RoomHasStairs: function(roomGUID: string): boolean
   -- Rotates either the currently dragged or currently selected room, if either exist
   RotateFocusedRoom: function(isLeft: boolean)
   -- Attempt to rotate an already placed room
   RotateRoom: function(roomGUID: string, isLeft: boolean)
   SelectFloorplan: function(roomID: number)
   SetViewedFloor: function(floor: number)
   StartDrag: function()
   StopDrag: function()
   StopDraggingRoom: function()
   ZoomLayoutCamera: function(zoomIn: boolean): boolean
