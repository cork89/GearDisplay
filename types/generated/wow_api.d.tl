-- EventSchedulerUIDocumentation.lua
global record C_EventScheduler
   -- Returns true if there are any events eligible to show for the player.
   CanShowEvents: function(): boolean
   -- Clears reminder on a scheduled event. Must use endTime to identify which specific instance in the case of repeating ones.
   ClearReminder: function(eventKey: string)
   -- Returns the name of the continent with current events [may return nothing]
   GetActiveContinentName: function(): string
   -- Will try to figure out a UiMap for an areaPOI. [nilable: uiMapID]
   GetEventUiMapID: function(areaPoiID: number): number
   -- Will try to figure out a map zone name for an areaPOI [nilable: name]
   GetEventZoneName: function(areaPoiID: number): string
   -- Will request data from the server on a throttle [may return nothing]
   GetOngoingEvents: function(): {OngoingEventInfo}
   -- Will request data from the server on a throttle [may return nothing]
   GetScheduledEvents: function(): {ScheduledEventInfo}
   -- True if the server sent a list, even if the list had 0 events.
   HasData: function(): boolean
   -- Returns whether there are any event reminders saved. Can include reminders that have expired since set and haven't gotten removed yet. Has to be called after cvars are loaded.
   HasSavedReminders: function(): boolean
   -- Requests events from the server, subject to throttle
   RequestEvents: function()
   -- Sets reminder on a scheduled event. Must use endTime to identify which specific instance in the case of repeating ones.
   SetReminder: function(eventKey: string)
end
